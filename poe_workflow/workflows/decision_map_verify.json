{
  "name": "通货应用验证-重试（示例）",
  "version": 1,
  "schema_version": "1.0",
  "steps": [
    {
      "id": "1",
      "kind": "action",
      "primitive": "copy",
      "params": {"store_as": "before"},
      "on_error": "retry",
      "delay_ms": 0
    },
    {
      "id": "2",
      "kind": "action",
      "primitive": "copy",
      "params": {"store_as": "after"},
      "on_error": "retry",
      "delay_ms": 0
    },
    {
      "id": "3",
      "kind": "loop",
      "condition": {
        "any": [
          {"source": "ctx_diff", "key_a": "before", "key_b": "after", "op": "nequals"},
          {"source": "ctx", "key": "__loop_index", "op": "ge", "value": 9}
        ]
      },
      "body": [
        {
          "id": "3.1",
          "kind": "action",
          "primitive": "use_currency",
          "params": {"currency": "重铸石", "target": "map_cell"},
          "on_error": "retry",
          "delay_ms": 0
        },
        {
          "id": "3.2",
          "kind": "action",
          "primitive": "move_offset",
          "params": {"anchor": "map_cell", "dx": 40, "dy": 40},
          "on_error": "retry",
          "delay_ms": 0
        },
        {
          "id": "3.3",
          "kind": "action",
          "primitive": "move_to_anchor",
          "params": {"anchor": "map_cell"},
          "on_error": "retry",
          "delay_ms": 0
        },
        {
          "id": "3.4",
          "kind": "action",
          "primitive": "copy",
          "params": {"store_as": "after"},
          "on_error": "retry",
          "delay_ms": 0
        }
      ],
      "on_error": "retry",
      "delay_ms": 0
    }
  ]
}
